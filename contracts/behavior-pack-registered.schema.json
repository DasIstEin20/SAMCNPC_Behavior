        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "samcnpc:set_attack_target_from_recent_attacker"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "leash": {
                  "description": "Fixed retaliation pursuit radius in blocks.",
                  "type": "number",
                  "minimum": 1.0,
                  "maximum": 32.0,
                  "default": 24.0
                },
                "durationTicks": {
                  "description": "Original retaliation deadline in game ticks.",
                  "type": "integer",
                  "minimum": 20.0,
                  "maximum": 2400.0,
                  "default": 600.0
                },
                "allowPlayers": {
                  "description": "Allow eligible players; summoner/friendly checks still apply.",
                  "type": "boolean",
                  "default": false
                }
              }
            }
          },
