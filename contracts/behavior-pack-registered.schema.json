          "properties": {
            "action": {
              "const": "samcnpc:clear_attack_target"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            }
          },
          "required": [
            "action"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "samcnpc:look_at_summoner"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            }
          },
          "required": [
            "action"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "samcnpc:look_at_target"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            }
          },
          "required": [
            "action"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "samcnpc:move_to_summoner"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "speed": {
                  "description": "Values above 1 request ordinary sprint; no hidden physics boost.",
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 1.5
                },
                "stopDistance": {
                  "description": "Horizontal stopping distance in blocks.",
                  "type": "number",
                  "minimum": 0.0,
                  "maximum": 16.0
                },
                "startDistance": {
                  "description": "Horizontal distance needed to start following after stopping.",
                  "type": "number",
                  "minimum": 0.25,
                  "maximum": 32.0,
                  "x-samcnpc-default-from": {
                    "parameter": "stopDistance",
                    "offset": 2.0
                  },
                  "x-samcnpc-greater-than": "stopDistance"
                }
              },
              "required": [
                "speed",
                "stopDistance"
              ]
            }
          },
          "required": [
            "action",
            "args"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "samcnpc:move_to_target"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "speed": {
                  "description": "Values above 1 request ordinary sprint; no hidden physics boost.",
                  "type": "number",
                  "minimum": 0.1,
                  "maximum": 1.5
                },
                "stopDistance": {
                  "description": "Horizontal stopping distance in blocks.",
                  "type": "number",
                  "minimum": 0.0,
                  "maximum": 16.0
                }
              },
              "required": [
                "speed",
                "stopDistance"
              ]
            }
          },
          "required": [
            "action",
            "args"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "samcnpc:run_combat_task"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            }
          },
          "required": [
            "action"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "samcnpc:run_delivery_task"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            }
          },
          "required": [
