{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samcnpc.invalid/schema/behavior-pack-registered-v1.json",
  "title": "SAMCNPC registered behavior components v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "description",
    "priority",
    "channels",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$",
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "maxLength": 512
    },
    "priority": {
      "type": "integer",
      "minimum": -100000,
      "maximum": 100000
    },
    "channels": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "enum": [
          "movement",
          "look",
          "main_hand",
          "off_hand",
          "combat",
          "interaction",
          "block_action",
          "inventory"
        ]
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/rule"
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "priority",
        "when",
        "actions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+$",
          "maxLength": 96
        },
        "priority": {
          "type": "integer",
          "minimum": -100000,
          "maximum": 100000
        },
        "cooldownTicks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120000
        },
        "when": {
          "$ref": "#/$defs/expr"
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/action"
          }
        }
      }
    },
    "expr": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "test"
          ],
          "properties": {
            "test": {
              "$ref": "#/$defs/test"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "all"
          ],
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/expr"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/expr"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/expr"
            }
          }
        }
      ]
    },
    "test": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "condition": {
              "const": "samcnpc:always"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            }
          },
          "required": [
            "condition"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "condition": {
              "const": "samcnpc:distance_to_summoner"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "operator": {
                  "description": "Compare the observed value with the supplied value.",
                  "type": "string",
                  "enum": [
                    "gt",
                    "gte",
                    "lt",
                    "lte",
                    "eq"
                  ]
                },
                "blocks": {
                  "description": "Horizontal distance in blocks.",
                  "type": "number",
                  "minimum": 0.0,
                  "maximum": 256.0
                }
              },
              "required": [
                "operator",
                "blocks"
              ]
            }
          },
          "required": [
            "condition",
            "args"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "condition": {
              "const": "samcnpc:has_attack_target"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            }
          },
          "required": [
            "condition"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "condition": {
              "const": "samcnpc:has_summoner"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            }
          },
          "required": [
            "condition"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "condition": {
              "const": "samcnpc:has_unhandled_damage"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            }
          },
          "required": [
            "condition"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "condition": {
              "const": "samcnpc:health_fraction"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "operator": {
                  "description": "Compare the observed value with the supplied value.",
                  "type": "string",
                  "enum": [
                    "gt",
                    "gte",
                    "lt",
                    "lte",
                    "eq"
                  ]
                },
                "value": {
                  "description": "Current health divided by maximum health.",
                  "type": "number",
                  "minimum": 0.0,
                  "maximum": 1.0
                }
              },
              "required": [
                "operator",
                "value"
              ]
            }
          },
          "required": [
            "condition",
            "args"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "condition": {
              "const": "samcnpc:summoner_online"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            }
          },
          "required": [
            "condition"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "condition": {
              "const": "samcnpc:target_alive"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            }
          },
          "required": [
            "condition"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "condition": {
              "const": "samcnpc:task_combat_ready"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            }
          },
          "required": [
            "condition"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "condition": {
              "const": "samcnpc:task_inventory_ready"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            }
          },
          "required": [
            "condition"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "condition": {
              "const": "samcnpc:task_inventory_requested"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            }
          },
          "required": [
            "condition"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "condition": {
              "const": "samcnpc:task_reaction_ready"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            }
          },
          "required": [
            "condition"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "condition": {
              "const": "samcnpc:task_ready"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            }
          },
          "required": [
            "condition"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "condition": {
              "const": "samcnpc:was_hurt_recently"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "withinTicks": {
                  "description": "Elapsed game ticks since damage.",
                  "type": "integer",
                  "minimum": 1.0,
                  "maximum": 120000.0
                }
              },
              "required": [
                "withinTicks"
              ]
            }
          },
          "required": [
            "condition",
            "args"
          ]
        }
      ]
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "action": {
              "const": "samcnpc:attack_target"
            },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "properties": {}
            }
          },
          "required": [
