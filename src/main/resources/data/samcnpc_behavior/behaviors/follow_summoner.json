{
  "schemaVersion": 1,
  "id": "samcnpc:follow_summoner",
  "description": "Follow the bound summoner through bounded native routes with a three-dimensional dead-zone; wait safely when unavailable.",
  "priority": 100,
  "channels": [
    "movement",
    "look"
  ],
  "rules": [
    {
      "id": "follow_or_wait",
      "priority": 100,
      "when": {
        "test": {
          "condition": "samcnpc:summoner_online"
        }
      },
      "actions": [
        {
          "action": "samcnpc:move_to_summoner",
          "args": {
            "speed": 1.0,
            "stopDistance": 3.0,
            "startDistance": 5.0
          }
        }
      ]
    }
  ]
}
