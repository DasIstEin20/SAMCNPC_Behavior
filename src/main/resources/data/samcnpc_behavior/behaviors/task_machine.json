{
  "schemaVersion": 1,
  "id": "samcnpc:task_machine",
  "description": "Bounded supplied feeds, actual output collection and physical return through generic container endpoints.",
  "priority": 100,
  "channels": [
    "movement",
    "look",
    "main_hand",
    "block_action",
    "inventory",
    "interaction",
    "combat",
    "off_hand"
  ],
  "rules": [
    {
      "id": "new_damage",
      "priority": 1000,
      "when": {
        "test": {
          "condition": "samcnpc:task_reaction_ready"
        }
      },
      "actions": [
        {
          "action": "samcnpc:begin_task_reaction"
        }
      ]
    },
    {
      "id": "advance_combat",
      "priority": 900,
      "when": {
        "test": {
          "condition": "samcnpc:task_combat_ready"
        }
      },
      "actions": [
        {
          "action": "samcnpc:run_combat_task"
        }
      ]
    },
    {
      "id": "begin_inventory",
      "priority": 800,
      "when": {
        "test": {
          "condition": "samcnpc:task_inventory_requested"
        }
      },
      "actions": [
        {
          "action": "samcnpc:begin_task_inventory"
        }
      ]
    },
    {
      "id": "advance_inventory",
      "priority": 700,
      "when": {
        "test": {
          "condition": "samcnpc:task_inventory_ready"
        }
      },
      "actions": [
        {
          "action": "samcnpc:run_inventory_task"
        }
      ]
    },
    {
      "id": "advance_machine",
      "priority": 100,
      "when": {
        "all": [
          {
            "test": {
              "condition": "samcnpc:task_ready"
            }
          },
          {
            "not": {
              "test": {
                "condition": "samcnpc:task_combat_ready"
              }
            }
          }
        ]
      },
      "actions": [
        {
          "action": "samcnpc:run_machine_task"
        }
      ]
    }
  ]
}
